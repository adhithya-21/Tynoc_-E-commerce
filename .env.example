AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=form-and-field
# Optional for DynamoDB Local. Never use static credentials in production.
DYNAMODB_ENDPOINT=http://localhost:8000
# AWS SDK uses the standard credential provider chain (IAM role/profile/environment).
# Optional server-only bearer token for POST/PATCH/DELETE catalog administration.
ADMIN_API_TOKEN=
# Optional catalog seed source; defaults to the local Next.js server.
SEED_SOURCE_URL=http://localhost:3000
